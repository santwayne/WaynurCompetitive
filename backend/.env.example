# Postgres connection
DATABASE_URL=postgres://waynur:CHANGE_ME@localhost:5432/waynur_competitive
DATABASE_SSL=false
# 32+ random characters (openssl rand -hex 32)
JWT_SECRET=
TOKEN_TTL=12h
PORT=4100
# Comma-separated frontend origins, e.g. https://competitive.waynur.com
CORS_ORIGINS=
# Public address of the app: used in the links sent on WhatsApp
APP_URL=https://competitive.waynur.com

# Sign-up: false = only the Super Admin can create centres
PUBLIC_SIGNUP=true
TRIAL_DAYS=14
TRIAL_STUDENT_LIMIT=100

# Encrypts each centre's WhatsApp token in the database (openssl rand -hex 32).
# Set once and never change it, or every centre must be reconnected.
CREDENTIALS_ENCRYPTION_KEY=

# WhatsApp (Meta Cloud API). One Meta app for the platform; each centre's
# number + token is added from the Super Admin panel, not here.
#   Webhook callback URL: https://competitive.waynur.com/api/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Language code the templates were approved in (en, en_US, hi …)
WA_TEMPLATE_LANG=en
# How long a WhatsApp login link works
MAGIC_LINK_TTL=72h

# Optional AI (hints, next-class wording). Without a key the app uses plain templates.
ANTHROPIC_API_KEY=
AI_AUTOMATION_MODEL=claude-haiku-4-5
AI_DAILY_LIMIT_PER_CENTRE=300

# Loop thresholds (percent) — defaults shown
LOOP_STUDENT_WEAK_BELOW=50
LOOP_TOPIC_WEAK_BELOW=60
LOOP_SHARED_SHARE=40
LOOP_PRACTICE_SIZE=5
# Longest trial the Super Admin can set, in days from today.
TRIAL_MAX_DAYS=30
