# Postgres connection
DATABASE_URL=postgres://waynur:CHANGE_ME@localhost:5432/waynur_competitive
DATABASE_SSL=false
# 32+ random characters (openssl rand -hex 32)
JWT_SECRET=
TOKEN_TTL=12h
PORT=4100
# Comma-separated frontend origins, e.g. https://competitive.waynur.com
CORS_ORIGINS=

# Optional AI (hints, next-class wording). Without a key the app uses plain templates.
ANTHROPIC_API_KEY=
AI_AUTOMATION_MODEL=claude-haiku-4-5
AI_DAILY_LIMIT_PER_CENTRE=300

# Loop thresholds (percent) — defaults shown
LOOP_STUDENT_WEAK_BELOW=50
LOOP_TOPIC_WEAK_BELOW=60
LOOP_SHARED_SHARE=40
LOOP_PRACTICE_SIZE=5
